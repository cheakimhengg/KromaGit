{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KromaGit",
  "mainBinaryName": "KromaGit",
  "version": "0.2.2",
  "identifier": "dev.kromagit.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KromaGit",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#1b1d24",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI Git client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwQUIzMEE0NDE2QUQ1MEIKUldRTDFXcEJwRENyZ0txUThmaEIrcE5tSXh4dlRETUwveTZXMVNOcm5NamZBdGdYU3BKQUg4Y24K",
      "endpoints": [
        "https://github.com/cheakimhengg/KromaGit/releases/latest/download/latest.json"
      ]
    }
  }
}
